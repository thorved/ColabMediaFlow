# Enable Google Drive API and Colab API in your OAuth client's project.
GOOGLE_OAUTH_CLIENT_ID=replace-with-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=replace-with-refresh-token
DRIVE_DOWNLOAD_FOLDER_ID=replace-with-media-download-folder-id
NOTEBOOK_PARENT_FOLDER_ID=replace-with-colab-notebooks-folder-id

# Generate your own random value for local API requests.
API_KEY=replace-with-random-local-api-key
RUN_INTERVAL=1m
STATE_DB=colabmediaflow.db

# Local default. Docker binds inside the container and maps the port on the host.
# LISTEN_ADDR=127.0.0.1:8080
